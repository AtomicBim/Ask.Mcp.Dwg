OWUI_URL=your_value_here
OWUI_API_KEY=your_value_here
OPENROUTER_API_KEY=your_value_here
VISION_MODEL=your_value_here
MCP_TOKEN=your_value_here
REQUIRE_USER_HEADER=your_value_here
LOOK_MAX_TILES=your_value_here
SPEC_ROWS_LIMIT=your_value_here

# --- производительность (необязательно, указаны значения по умолчанию) ---
# число процессов-воркеров для PyMuPDF (по умолчанию cpu_count-1)
INGEST_WORKERS=3
# документов PDF, удерживаемых открытыми в каждом воркере
WORKER_DOC_LRU=2
# слов выше штампа, ниже которых find_tables не вызывается (пустой бланк); 0 = выключить префильтр
TABLE_PREFILTER_MIN_WORDS=8
# одновременных запросов к визуальной модели
VISION_CONCURRENCY=4
# максимум листов в одном вызове look_many
LOOK_MANY_MAX=8
# фоновый прогрев таблиц ОД/ведомостей после open_project и число его слотов в пуле
WARMUP=true
WARMUP_SLOTS=1
